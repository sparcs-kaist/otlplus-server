  PROFESSOR
  MAJORS
  DEGREE
  EXAMTIME
  CLASSTIME
  TAKEN_LECTURES
  CHARGE
}

enum DeviceType {
  ANDROID
  IOS
  WEB
}

enum AgreementType {
  INFO
  MARKETING
  NIGHT_MARKETING
}
