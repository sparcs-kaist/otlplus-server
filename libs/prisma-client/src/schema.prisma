  subject_department    subject_department @relation(fields: [subject_department_id], references: [id], onUpdate: Restrict)

  @@index([paper_professor_id])
  @@index([subject_department_id])
}

model paper_professor {
  id                         Int                          @id @default(autoincrement())
  department                 String?                      @db.VarChar(60)
  first_conference_title     String?                      @db.VarChar(255)
  first_journal_title        String?                      @db.VarChar(255)
  lab_link                   String?                      @db.VarChar(255)
  orcid_id                   String?                      @db.VarChar(20)
  prof_name                  String?                      @db.VarChar(255)
  rid                        String?                      @db.VarChar(20)
  papers                     paper[]
  prof_names_to_prof_link    paper_prof_to_subject_prof[]
  paper_professor_department paper_professor_department[]
}

model paper {
  id               Int              @id @default(autoincrement())
  professor_id     Int?
  title            String?          @db.VarChar(1000)
  abstract         String?          @db.Text
  keywords         String?          @db.Text
  doi              String?          @db.VarChar(100)
  pdf_link         String?          @db.VarChar(300)
  xml_link         String?          @db.VarChar(255)
  aggregationType  String?          @db.VarChar(30)
  article_number   String?          @db.VarChar(50)
  cited_count      Float?
  citedby_count    Float?
  coverDate        DateTime?        @db.Date
  coverDisplayDate String?          @db.VarChar(100)
  description      String?          @db.Text
  eIssn            String?          @db.VarChar(10)
  issn             String?          @db.VarChar(10)
  issueIdentifier  String?          @db.VarChar(20)
  pageRange        String?          @db.VarChar(20)
  page_range       String?          @db.VarChar(20)
  publicationName  String?          @db.VarChar(500)
  publish_month    String?          @db.VarChar(8)
  publish_year     Float?
  source_id        Float?
  source_title     String?          @db.VarChar(255)
  volume           String?          @db.VarChar(100)
  professor        paper_professor? @relation(fields: [professor_id], references: [id], onUpdate: Restrict)

  @@index([professor_id])
}

enum SyncType {
