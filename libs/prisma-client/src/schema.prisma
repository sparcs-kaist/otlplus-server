  @@unique([end_year, department_id])
  @@unique([start_year, department_id])
  @@index([department_id])
  @@index([end_year])
  @@index([start_year])
}

model planner_arbitraryplanneritem {
  id                 Int                 @id @default(autoincrement())
  is_excluded        Boolean
  year               Int
  semester           Int
  type               String              @db.VarChar(12)
  type_en            String              @db.VarChar(36)
  credit             Int
  credit_au          Int
  department_id      Int?
  planner_id         Int
  subject_department subject_department? @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planner_planner    planner_planner     @relation(fields: [planner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([department_id])
  @@index([planner_id])
  @@index([semester])
  @@index([year])
}

model planner_futureplanneritem {
  id              Int             @id @default(autoincrement())
  is_excluded     Boolean
  year            Int
  semester        Int
  course_id       Int
  planner_id      Int
  subject_course  subject_course  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planner_planner planner_planner @relation(fields: [planner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id])
  @@index([planner_id])
  @@index([semester])
  @@index([year])
}

model planner_planner {
  id                                Int                                 @id @default(autoincrement())
  start_year                        Int
  end_year                          Int
  arrange_order                     Int                                 @db.SmallInt
  general_track_id                  Int
  major_track_id                    Int
