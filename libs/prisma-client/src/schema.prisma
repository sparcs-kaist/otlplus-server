  planner_futureplanneritem         planner_futureplanneritem[]
  graduation_generaltrack           graduation_generaltrack             @relation(fields: [general_track_id], references: [id], onUpdate: Restrict)
  graduation_majortrack             graduation_majortrack               @relation(fields: [major_track_id], references: [id], onUpdate: Restrict)
  session_userprofile               session_userprofile                 @relation(fields: [user_id], references: [id], onUpdate: Restrict)
  planner_planner_additional_tracks planner_planner_additional_tracks[]
  planner_takenplanneritem          planner_takenplanneritem[]

  @@index([arrange_order])
  @@index([end_year])
  @@index([general_track_id])
  @@index([major_track_id])
  @@index([start_year])
  @@index([user_id])
}

model planner_planner_additional_tracks {
  id                         Int                        @id @default(autoincrement())
  planner_id                 Int
  additionaltrack_id         Int
